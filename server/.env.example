NODE_ENV=development
PORT=3000
DATABASE_URL=file:./dev.db
TRUSTED_ORIGINS=http://localhost:5173
BETTER_AUTH_SECRET=change-me-in-production-min-32-chars
BETTER_AUTH_URL=http://localhost:3000

# WorkOS (AuthKit) — migration target, replaces Better Auth
# Staging uses client_.../sk_test_...; Production uses its own client_.../sk_live_...
WORKOS_CLIENT_ID=client_01KY4CTA9BD15EWK2EEMN4AQGD
WORKOS_API_KEY=sk_test_          # server only — secret, never expose to client
WORKOS_REDIRECT_URI=http://localhost:5173/callback   # must match the dashboard exactly
WORKOS_COOKIE_PASSWORD=          # random 32+ char string for session cookie encryption

SENTRY_DSN=
SENTRY_ENVIRONMENT=
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme
